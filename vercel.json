{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nuxtjs",
  "installCommand": "corepack enable && corepack prepare pnpm@10.30.3 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "env": {
    "NITRO_PRESET": "vercel",
    "NUXT_PUBLIC_USE_MOCK_DATA": "true",
    "NUXT_PUBLIC_SITE_URL": "https://docetra-delta.vercel.app"
  }
}
